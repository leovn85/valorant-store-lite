{
  "manifest_version": 3,
  "name": "Riot Cookie Grabber",
  "version": "1.1",
  "description": "Get HttpOnly Cookies from Riot Games",
  "permissions": ["cookies"],
  "host_permissions": [
    "*://*.riotgames.com/*"
  ],
  "incognito": "split", 
  "action": {
    "default_popup": "popup.html"
  }
}